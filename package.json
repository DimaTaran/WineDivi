{
  "name": "winedivi",
  "version": "1.0.0",
  "description": "Divi Child Theme with Vite build system and React",
  "author": "Dima Taran",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --config vite/vite.config.j",
